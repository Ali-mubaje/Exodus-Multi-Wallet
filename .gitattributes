# Normalize line endings in the repo to LF; check out native on Windows.
* text=auto eol=lf

# Shell scripts must stay LF or they won't run on macOS/Linux.
*.sh text eol=lf

# Windows batch files want CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets – never touch line endings.
*.png binary
*.jpg binary
*.ico binary
*.asar binary
